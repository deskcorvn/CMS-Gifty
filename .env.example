# Sao chép thành .env.local khi chạy máy; trên Vercel đặt ở Project Settings → Environment Variables.
# KHÔNG commit giá trị thật.

# Postgres (Neon). Dùng chuỗi pooled (host có "-pooler").
DATABASE_URL=

# Chuỗi ngẫu nhiên ≥ 32 ký tự, ký cookie đăng nhập. Tạo: openssl rand -base64 48
SESSION_SECRET=

# Địa chỉ site, dùng trong link email và QR chứng chỉ. Ví dụ https://daotao.giftytech.com
SITE_URL=

# Tài khoản nhận học phí (in lên mã VietQR). VIETQR_BANK là mã/tên ngắn ngân hàng theo vietqr.io (MB, VCB, TCB…).
VIETQR_BANK=
VIETQR_ACCOUNT=
VIETQR_NAME=
# Chỉ đặt nếu ngân hàng liên kết SePay qua VA bắt buộc tiền tố nội dung (vd SEVQR)
VIETQR_PREFIX=

# Webhook SePay: trên SePay chọn Bảo mật = API Key, URL https://<site>/api/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
# Token API SePay (đối soát hằng ngày + nút "Đối soát" trong quản trị). Để trống thì bỏ qua đối soát.
SEPAY_API_TOKEN=

# Khóa vào trang /quan-tri (≥ 16 ký tự)
ADMIN_KEY=
# Vercel Cron tự gửi kèm; đặt chuỗi ngẫu nhiên
CRON_SECRET=

# Email: SMTP bất kỳ, hoặc Gmail App Password (EMAIL_USER/EMAIL_PASS) như giftyid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM=Gifty Tech <hotro.giftytech@gmail.com>

# Vercel Blob (lưu ảnh SP04). Vercel tự thêm khi bật Blob cho project.
BLOB_READ_WRITE_TOKEN=
